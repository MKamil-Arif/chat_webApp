# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/chat_app

# Random secret used to hash visitor IP addresses. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=

PORT=5000

# Web Push keys for owner notifications. Generate once with:
#   npx web-push generate-vapid-keys
# Never change them later, or every saved subscription stops working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
