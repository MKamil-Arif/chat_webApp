# MongoDB connection string (MongoDB Atlas or local). The only required setting.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/chat_app

# Optional. When empty, they are generated once and stored in the database
# (see secrets.js). If you set them, never change them later.
#   IP_SALT:      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   VAPID keys:   npx web-push generate-vapid-keys
IP_SALT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

PORT=5000
